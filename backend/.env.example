ENV=production
DATABASE_URL=postgresql+psycopg2://thermora:thermora@postgres:5432/thermora

NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_COMMUNITY=AG
NASA_POWER_PARAMETERS=T2M,T2M_MAX,T2M_MIN,RH2M,WS2M,ALLSKY_SFC_SW_DWN,PS,PRECTOTCORR

DEFAULT_LAT=28.6692
DEFAULT_LON=77.4538

HTSI_SAFE_MAX=30
HTSI_CAUTION_MAX=55
HTSI_DANGER_MAX=80
ALERT_RISK_THRESHOLD=55

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

FCM_SERVER_KEY=

SECRET_KEY=change-me-in-production-thermora-secret
